# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# Database
# For SQL Server with mssql-django use:
# DB_ENGINE=mssql
# DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENGINE=mssql
DB_NAME=cartillas_operaciones_mina
DB_HOST=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Local uploads
MEDIA_ROOT=media
MEDIA_URL=/media/

# External services
APIPERU_TOKEN=

# Temporary legacy diagnostics. Keep False unless actively debugging locally.
DEBUG_LOGIN_REQUESTS=False
