# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# Database
# For SQL Server with mssql-django use:
# DB_ENGINE=mssql
# DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENGINE=mssql
DB_NAME=cartillas_operaciones_mina
DB_HOST=localhost
DB_PORT=1433
# Optional: override DB_HOST/DB_PORT with a full SQL Server value.
# Examples: 192.168.0.101,55188 or tcp:192.168.0.101,55188
DB_SERVER_FORMAT=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_MARS_CONNECTION=yes
DB_CONNECTION_TIMEOUT=30
DB_EXTRA_PARAMS=
# Use True for FreeTDS when DB_HOST/DB_SERVER_FORMAT must become SERVER instead of SERVERNAME.
DB_HOST_IS_SERVER=False
# Use auto for FreeTDS/libtdsodbc, True to force, False to disable.
DB_INLINE_NULL_PARAMS=auto

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Optional initial admin for seed_mina_initial_data.
# Leave empty and use createsuperuser if you prefer manual creation.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_DNI=

# Local uploads
MEDIA_ROOT=media
MEDIA_URL=/media/

# External services
APIPERU_TOKEN=

# Temporary legacy diagnostics. Keep False unless actively debugging locally.
DEBUG_LOGIN_REQUESTS=False
